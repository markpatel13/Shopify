# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/shopify_elite

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_characters_long
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (using Gmail SMTP)
EMAIL_FROM=noreply@shopifyelite.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp

# API Configuration
API_VERSION=v1
MAX_PRODUCTS_PER_PAGE=20
MAX_ORDERS_PER_PAGE=10

# Admin Configuration
ADMIN_EMAIL=admin@shopifyelite.com
ADMIN_PASSWORD=Admin123!@#

# Development Settings
LOG_LEVEL=info
ENABLE_API_DOCS=true
ENABLE_SEED_DATA=true

# Production Settings (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=error
# ENABLE_API_DOCS=false
# ENABLE_SEED_DATA=false