# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/shopify_elite

# JWT Secret
JWT_SECRET=shopify_elite_super_secret_key_for_development_only_change_in_production
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=shopify_elite_refresh_secret_key_for_development_only
JWT_REFRESH_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@shopify-elite.com
ADMIN_PASSWORD=admin123456

# Security Configuration
BCRYPT_ROUNDS=10

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads